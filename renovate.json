{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency updates (ADR-0039): weekly, grouped, majors reviewed by hand, never auto-merged.",
  "extends": ["config:recommended", ":semanticCommitsDisabled", "helpers:pinGitHubActionDigests"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "One PR for all non-major npm updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm non-major"
    },
    {
      "description": "Majors one by one, never auto-merged.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Framework families move together.",
      "matchPackageNames": ["prisma", "@prisma/**"],
      "groupName": "prisma"
    },
    {
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "nestjs"
    },
    {
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "next and react"
    },
    {
      "matchPackageNames": ["typescript-eslint", "@typescript-eslint/**", "eslint"],
      "groupName": "eslint"
    },
    {
      "description": "AGENTS.md: TypeScript stays below 6.1 until typescript-eslint supports newer versions.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "docker images"
    },
    {
      "description": "Node follows .nvmrc (24 LTS); majors only by hand.",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
