// =============================================================================
// Lead Generation Agent: database schema (v1). Authoritative for table names.
// Design notes: docs/DATABASE_DESIGN.md, ADR-0006 (tenancy), ADR-0033 (entities).
//
// Conventions
// - UUIDv7 ids, timestamptz(3), snake_case tables/columns via @@map/@map.
// - Tenant tables: workspace_id NOT NULL + @@unique([workspaceId, id]). Every reference to
//   another tenant table is a COMPOSITE foreign key (workspace_id, x_id), so the database
//   rejects cross-workspace links even if application code has a bug.
// - Delete policy: Workspace -> rows CASCADE (purge job only; the app soft-deletes first).
//   Owned children CASCADE. Cross references NO ACTION (blocks deleting a referenced row on
//   its own but allows the workspace-wide purge). Optional user refs SET NULL.
// - Soft delete: deleted_at + partial unique indexes WHERE deleted_at IS NULL.
// - Actor columns (*_by_user_id) are informational uuids without FKs (users are soft-deleted).
// - CHECK constraints and role grants live in hand-written migration SQL.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

