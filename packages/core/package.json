{
  "name": "@lga/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backend core shared by api and worker: config, logging, errors, database, Valkey/BullMQ, health (ADR-0032).",
  "exports": {
    ".": {
      "@lga/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node ../../infra/scripts/dev-node.mjs",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@lga/contracts": "workspace:*",
    "@lga/shared": "workspace:*",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lga/config": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "24.19.4",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  }
}
