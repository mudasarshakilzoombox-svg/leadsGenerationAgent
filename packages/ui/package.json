{
  "name": "@lga/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "shadcn/ui components and design tokens shared by web apps (source package, compiled by the consumer).",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
