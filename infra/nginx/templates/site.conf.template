# VPS site with TLS (ARCHITECTURE §17.3, ADR-0040). Rendered at container start by the nginx
# image's envsubst into /etc/nginx/site/site.conf. Only ${LGA_*} variables are substituted
# (NGINX_ENVSUBST_FILTER), so nginx's own $variables stay untouched.
# Certificates: Let's Encrypt via the certbot service (webroot), first issued per docs/OPS_SETUP.md.

# HTTP: ACME challenges, then redirect everything to HTTPS.
server {
  listen 80;
  server_name ${LGA_APP_DOMAIN} ${LGA_LINKS_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location = /nginx-health { access_log off; add_header Content-Type text/plain; return 200 "ok\n"; }
  location / { return 301 https://$host$request_uri; }
}

# App domain: the whole application.
server {
  listen 443 ssl;
  http2 on;
  server_name ${LGA_APP_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${LGA_APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LGA_APP_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_stapling on;
  ssl_stapling_verify on;
  resolver 1.1.1.1 9.9.9.9 valid=300s;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  include /etc/nginx/lga/app-locations.conf;
}

# Links domain: unsubscribe (and future click redirects) only (ADR-0015).
server {
  listen 443 ssl;
  http2 on;
  server_name ${LGA_LINKS_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${LGA_LINKS_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LGA_LINKS_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;

  location /u/ {
    limit_req zone=public burst=60 nodelay;
    proxy_pass http://api;
  }
  location / { return 404; }
}

# Anything else (IP scans, unknown hosts): close the connection.
server {
  listen 443 ssl default_server;
  ssl_reject_handshake on;
}
