{
  "name": "lead-generation-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node infra/scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.dev.yml down",
    "infra:reset": "docker compose --env-file .env -f infra/docker/compose.dev.yml down -v",
    "infra:logs": "docker compose --env-file .env -f infra/docker/compose.dev.yml logs -f",
    "db:generate": "pnpm --filter @lga/core db:generate",
    "db:migrate": "pnpm --filter @lga/core db:migrate",
    "db:deploy": "pnpm --filter @lga/core db:deploy",
    "db:status": "pnpm --filter @lga/core db:status",
    "db:seed": "turbo run build --filter=@lga/core && pnpm --filter @lga/core db:seed",
    "smoke": "node infra/scripts/smoke.mjs",
    "stack:build": "node infra/scripts/build-images.mjs",
    "stack:up": "docker compose --env-file .env -f infra/docker/compose.prod.yml up -d --wait",
    "stack:down": "docker compose --env-file .env -f infra/docker/compose.prod.yml down",
    "stack:smoke": "node infra/scripts/smoke.mjs --web http://localhost:8080 --api http://localhost:8080",
    "ai:eval": "turbo run build --filter=@lga/core --output-logs=errors-only && pnpm --filter @lga/core ai:eval",
    "ai:selftest": "turbo run build --filter=@lga/worker --output-logs=errors-only && pnpm --filter @lga/worker ai:selftest"
  },
  "devDependencies": {
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "chokidar": "5.0.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
