# =============================================================================
# Lead Generation Agent: environment template
# Copy to .env (`pnpm setup` does this) and adjust. NEVER commit .env.
# All values below are LOCAL-ONLY placeholders, not real credentials.
# Passwords inside URLs must be URL-encoded if they contain special characters.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
# local | test | staging | production
APP_ENV=local
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development only (rejected in production).
LOG_PRETTY=true
RELEASE=dev
# Public origin of the web app (CSRF origin check, links). https:// in production.
APP_ORIGIN=http://localhost:3300
# fake | real. Fake third-party integrations (rejected in production).
INTEGRATIONS_MODE=fake

# ---- Ports (host) -----------------------------------------------------------
WEB_PORT=3300
API_PORT=4000
API_HOST=0.0.0.0
WORKER_HEALTH_PORT=4100
WORKER_HEALTH_HOST=0.0.0.0

# ---- PostgreSQL (docker compose) --------------------------------------------
POSTGRES_DB=lga
# Schema owner: runs migrations only.
POSTGRES_USER=lga_owner
POSTGRES_PASSWORD=change-me-local-owner
# Application role: DML only (created by infra/docker/postgres/init/01-roles.sh).
POSTGRES_APP_USER=lga_app
POSTGRES_APP_PASSWORD=change-me-local-app
POSTGRES_PORT=5432

# App connection (api, worker) and migration connection (prisma migrate).
DATABASE_URL=postgresql://lga_app:change-me-local-app@localhost:5432/lga
DATABASE_MIGRATOR_URL=postgresql://lga_owner:change-me-local-owner@localhost:5432/lga
DATABASE_POOL_MAX=10

# ---- Valkey (Redis-compatible, docker compose) ------------------------------
VALKEY_PASSWORD=change-me-local-valkey
VALKEY_PORT=6379
VALKEY_URL=redis://:change-me-local-valkey@localhost:6379/0

# ---- API --------------------------------------------------------------------
# Express "trust proxy": only nginx on the private network may set X-Forwarded-*.
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY_FACTOR=1
HEARTBEAT_INTERVAL_MS=60000

# ---- Authentication (api) ----------------------------------------------------
# Hash peppers (>= 32 chars). Rotating SESSION_PEPPER signs everyone out.
SESSION_PEPPER=change-me-local-sessionpepper
EMAIL_HASH_PEPPER=change-me-local-emailpepper
# Cloudflare Turnstile server secret. Required when INTEGRATIONS_MODE=real (fake mode accepts
# any token except "fake-fail").
# TURNSTILE_SECRET_KEY=

# ---- Field encryption and signed links (api + worker) -------------------------
# AES-256-GCM key ring for stored credentials (ADR-0021): JSON {"<version>":"<base64 32 bytes>"}.
# Rotate by adding a version and making it active; keep old versions until rows are re-encrypted.
APP_ENCRYPTION_KEYS='change-me-local-keyringenc'
APP_ENCRYPTION_ACTIVE_VERSION=1
# HMAC key ring for unsubscribe links (ADR-0024), keys >= 32 bytes. Links never expire, so never
# remove a key id that has signed links; rotate by adding an id and making it active.
UNSUBSCRIBE_TOKEN_KEYS='change-me-local-keyringhmac'
UNSUBSCRIBE_TOKEN_ACTIVE_KEY_ID=1

# ---- System email (worker) -----------------------------------------------------
# Local: Mailpit (UI on MAILPIT_UI_PORT). Production: the SES or Resend SMTP endpoint, e.g.
# smtps://USER:PASS@email-smtp.eu-west-1.amazonaws.com:465. Unset = emails are only logged.
SMTP_URL=smtp://localhost:1125
MAIL_FROM="Lead Generation Agent <no-reply@lga.test>"

# ---- Web --------------------------------------------------------------------
# Where the Next.js server reaches the API (internal network). Also enables the dev /api proxy.
INTERNAL_API_URL=http://localhost:4000
# Cloudflare Turnstile site key (public) for the signup/login widget. Unset = no widget; the forms
# send a dev token that only the API's fake verifier accepts (INTEGRATIONS_MODE=fake).
# TURNSTILE_SITE_KEY=

# ---- Local mail catcher (Mailpit) -------------------------------------------
MAILPIT_SMTP_PORT=1125
MAILPIT_UI_PORT=8125

# ---- Production-like stack (pnpm stack:up) ----------------------------------
# nginx host port for the full Docker stack.
HTTP_PORT=8080
# Public origin of the stack behind nginx (https://app.<domain> on the VPS).
STACK_APP_ORIGIN=http://localhost:8080

# ---- Later phases (leave empty until the feature exists) ---------------------
# VERIFIER_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# S3_ENDPOINT=
# S3_BUCKET_FILES=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=

# ---- AI (api + worker, ADR-0037) ---------------------------------------------
# Global AI kill switch. Routing and pricing default to packages/core/config/ai-*.yaml.
AI_DISABLED=false
# AI_ROUTING_FILE=
# AI_PRICING_FILE=
# Provider keys. OpenAI is the routed provider (packages/core/config/ai-routing.yaml): OPENAI_API_KEY is
# needed with INTEGRATIONS_MODE=real or for `pnpm ai:eval <task> --provider openai`.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Sign in with Google / Microsoft (api, AUTH-03) ------------------------------
# Fake mode shows a built-in fake sign-in page instead. Real mode enables a provider when both of
# its values are set. Setup steps and exact redirect URIs: docs/LONG_LEAD_TASKS.md.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=

# ---- Operations (api) ------------------------------------------------------------
# Client IPs allowed to open the Bull Board queue dashboard at /admin/queues (Super Admin only,
# ADR-0038). Comma-separated. Empty = nobody. Staging and production always deny until MFA (P6.1).
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
