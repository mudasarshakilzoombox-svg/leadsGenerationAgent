{
  "extends": "@lga/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "customConditions": ["@lga/source"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "scripts"]
}
