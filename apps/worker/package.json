{
  "name": "@lga/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background worker process (NestJS application context + BullMQ).",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../infra/scripts/dev-node.mjs --run dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@lga/contracts": "workspace:*",
    "@lga/core": "workspace:*",
    "@lga/shared": "workspace:*",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "nestjs-pino": "5.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lga/config": "workspace:*",
    "@nestjs/testing": "12.6.2",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.4",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  }
}
